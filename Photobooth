<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PHOTO BOOTH</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"></script>
<style>
  :root{
    --plum:#3B1F2B;
    --plum-dark:#231018;
    --gold:#E8B84B;
    --gold-dim:#B98F34;
    --cream:#F3E9D8;
    --ink:#241417;
    --flash:#FFF8ED;
    --red:#C4463A;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      linear-gradient(180deg, rgba(20,26,16,0.55), rgba(20,26,16,0.75)),
      url('data:image/jpeg;base64,') center/cover no-repeat fixed;
    font-family:'Space Mono', monospace;
    color:var(--cream);
    display:flex;
    justify-content:center;
    padding:24px 12px 48px;
    min-height:100vh;
  }
  .rig{
    width:100%;
    max-width:420px;
  }
  .marquee{
    text-align:center;
    font-family:'Bebas Neue', sans-serif;
    letter-spacing:6px;
    font-size:34px;
    color:var(--gold);
    padding:14px 0 10px;
    position:relative;
    text-shadow:0 2px 10px rgba(0,0,0,0.55);
  }
  .bulbs{
    display:flex;
    justify-content:space-between;
    padding:0 6px;
  }
  .bulbs span{
    width:6px;height:6px;border-radius:50%;
    background:var(--gold-dim);
    box-shadow:0 0 0 rgba(232,184,75,0);
    transition:box-shadow .3s, background .3s;
  }
  .bulbs.on span{
    background:var(--gold);
    box-shadow:0 0 6px 2px rgba(232,184,75,0.7);
    animation:twinkle 1.2s infinite alternate;
  }
  .bulbs.on span:nth-child(2n){animation-delay:.3s;}
  .bulbs.on span:nth-child(3n){animation-delay:.6s;}
  @keyframes twinkle{
    from{opacity:.5;}
    to{opacity:1;}
  }
  .booth{
    background:rgba(30,26,20,0.55);
    backdrop-filter:blur(6px);
    -webkit-backdrop-filter:blur(6px);
    border-radius:14px;
    padding:16px;
    position:relative;
    box-shadow:0 0 0 1px rgba(232,184,75,0.35), 0 12px 30px rgba(0,0,0,0.35);
  }
  .curtainRow{
    display:flex;
    gap:10px;
  }
  .curtain{
    width:16px;
    border-radius:6px;
    background:repeating-linear-gradient(
      180deg,
      rgba(74,90,53,0.9) 0 14px,
      rgba(42,54,28,0.9) 14px 28px
    );
    flex-shrink:0;
  }
  .screen{
    flex:1;
    position:relative;
    border-radius:10px;
    overflow:hidden;
    background:#000;
    aspect-ratio:3/4;
  }
  video, canvas.captureCanvas{
    width:100%;
    height:100%;
    object-fit:cover;
    transform:scaleX(-1);
    display:block;
  }
  canvas.captureCanvas{display:none;}
  .flashOverlay{
    position:absolute;
    inset:0;
    background:var(--flash);
    opacity:0;
    pointer-events:none;
  }
  .flashOverlay.go{
    animation:flashPop .35s ease-out;
  }
  @keyframes flashPop{
    0%{opacity:0;}
    15%{opacity:1;}
    100%{opacity:0;}
  }
  .countOverlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Bebas Neue', sans-serif;
    font-size:100px;
    color:var(--flash);
    text-shadow:0 0 24px rgba(0,0,0,0.6);
    opacity:0;
    pointer-events:none;
    transition:opacity .15s;
  }
  .countOverlay.show{opacity:1;}
  .shotDots{
    position:absolute;
    top:10px;
    left:10px;
    display:flex;
    gap:6px;
  }
  .shotDots span{
    width:9px;height:9px;border-radius:50%;
    border:1px solid var(--gold);
    background:transparent;
  }
  .shotDots span.filled{background:var(--gold);}
  .statusLine{
    text-align:center;
    font-size:12px;
    letter-spacing:2px;
    color:var(--gold-dim);
    margin-top:12px;
    min-height:16px;
  }
  .controls{
    display:flex;
    justify-content:center;
    margin-top:14px;
    gap:12px;
  }
  button{
    font-family:'Space Mono', monospace;
    font-weight:700;
    letter-spacing:1px;
    border:none;
    cursor:pointer;
  }
  .goBtn{
    background:var(--red);
    color:var(--flash);
    border-radius:50%;
    width:78px;height:78px;
    font-size:14px;
    box-shadow:0 0 0 4px var(--gold-dim), 0 4px 10px rgba(0,0,0,0.4);
    letter-spacing:2px;
  }
  .goBtn:active{transform:scale(0.96);}
  .goBtn:disabled{opacity:.5;cursor:default;}
  .smallBtn{
    background:transparent;
    border:1px solid var(--gold-dim);
    color:var(--cream);
    padding:10px 16px;
    border-radius:8px;
    font-size:12px;
  }
  .smallBtn:hover{border-color:var(--gold);color:var(--gold);}
  .permBox{
    text-align:center;
    font-size:12px;
    line-height:1.7;
    color:var(--cream);
    padding:20px;
  }
  .permBox .smallBtn{margin-top:10px;}
  .stripWrap{
    margin-top:18px;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .stripWrap img{
    max-width:220px;
    width:100%;
    border-radius:2px;
    box-shadow:0 8px 20px rgba(0,0,0,0.45);
  }
  .stripActions{
    display:flex;
    gap:10px;
    margin-top:16px;
    opacity:0;
    transition:opacity .4s ease;
  }
  .stripActions.ready{
    opacity:1;
  }
  .printSlot{
    width:240px;
    height:14px;
    margin:6px auto 0;
    background:linear-gradient(180deg, #17110D, #2A211A);
    border-radius:3px;
    box-shadow:inset 0 2px 4px rgba(0,0,0,0.6), 0 1px 0 rgba(232,184,75,0.25);
    position:relative;
  }
  .printSlot::after{
    content:'';
    position:absolute;
    left:14px;right:14px;top:50%;
    height:2px;
    transform:translateY(-50%);
    background:rgba(232,184,75,0.5);
  }
  .stripOuter{
    overflow:hidden;
    width:230px;
    margin:0 auto;
  }
  .filmStrip{
    width:230px;
    height:408.9px;
    position:relative;
    transform:translateY(-190%);
    transition:transform 2.8s cubic-bezier(.37,.02,.16,1);
    filter:drop-shadow(0 8px 16px rgba(0,0,0,0.45));
  }
  .filmStrip.out{
    transform:translateY(0);
  }
  .booth{
    transition:opacity .45s ease, transform .45s ease, max-height .45s ease;
    overflow:hidden;
    max-height:900px;
  }
  .booth.gone{
    opacity:0;
    transform:scale(0.97);
    max-height:0;
    margin:0;
    padding:0;
    pointer-events:none;
  }
  .frameSlot{
    position:absolute;
    background:#1c1c1c;
    overflow:hidden;
    opacity:0;
    transform:scale(0.9);
    transition:opacity .8s ease, transform .8s ease;
  }
  .frameSlot.in{
    opacity:1;
    transform:scale(1);
  }
  .frameSlot img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }
  .frameSlot.heartSlot{
    background:transparent;
  }
  .frameArt{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:fill;
    pointer-events:none;
    z-index:2;
  }
  .hidden{display:none !important;}
  .sr-only{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;
    overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
  }
</style>
</head>
<body>
<div class="rig">
  <h2 class="sr-only">โฟโต้บูธจำลอง: เปิดกล้อง บันทึกวิดีโอสั้นๆ ก่อนกดชัตเตอร์ ถ่าย 2 ช็อตต่อเนื่อง แล้วแปลงเป็นภาพเคลื่อนไหวแบบ Live Photo ให้ดาวน์โหลด</h2>

  <div class="marquee">PHOTO BOOTH</div>
  <div class="bulbs" id="bulbs">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="booth" id="booth">
    <div class="curtainRow">
      <div class="curtain"></div>
      <div class="screen" id="screen">
        <video id="video" autoplay playsinline muted></video>
        <canvas class="captureCanvas" id="captureCanvas"></canvas>
        <div class="shotDots" id="shotDots">
          <span></span><span></span>
        </div>
        <div class="countOverlay" id="countOverlay"></div>
        <div class="flashOverlay" id="flashOverlay"></div>
        <div class="permBox hidden" id="permBox">
          ต้องขออนุญาตใช้กล้องก่อนนะ<br>กดอนุญาต (Allow) ที่เบราว์เซอร์ถามด้านบน
          <br><button class="smallBtn" id="retryBtn">ลองใหม่</button>
        </div>
      </div>
      <div class="curtain"></div>
    </div>

    <div class="statusLine" id="statusLine">กดปุ่มเพื่อเริ่มถ่าย 2 รูปติดกัน</div>

    <div class="controls" id="liveControls">
      <button class="goBtn" id="goBtn">GO</button>
    </div>
  </div>

  <div class="printSlot"></div>
  <div class="stripWrap hidden" id="stripWrap">
    <div class="stripOuter" id="stripOuter">
      <div class="filmStrip" id="filmStrip"></div>
    </div>
    <div class="stripActions" id="stripActions">
      <button class="smallBtn" id="downloadAllBtn">ดาวน์โหลด Live Photo ติดกรอบ</button>
      <button class="smallBtn" id="retakeBtn">ถ่ายใหม่</button>
    </div>
  </div>
</div>

<script>
const video = document.getElementById('video');
const captureCanvas = document.getElementById('captureCanvas');
const goBtn = document.getElementById('goBtn');
const statusLine = document.getElementById('statusLine');
const countOverlay = document.getElementById('countOverlay');
const flashOverlay = document.getElementById('flashOverlay');
const shotDots = document.getElementById('shotDots').children;
const bulbs = document.getElementById('bulbs');
const permBox = document.getElementById('permBox');
const retryBtn = document.getElementById('retryBtn');
const liveControls = document.getElementById('liveControls');
const stripWrap = document.getElementById('stripWrap');
const stripOuter = document.getElementById('stripOuter');
const filmStrip = document.getElementById('filmStrip');
const stripActions = document.getElementById('stripActions');
const downloadAllBtn = document.getElementById('downloadAllBtn');
const retakeBtn = document.getElementById('retakeBtn');

const FRAME_ART_URI = 'data:image/png;base64,';
let liveShots = [];
let busy = false;
let workerBlobUrl = null;

fetch('https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.worker.js')
  .then(r => r.blob())
  .then(blob => { workerBlobUrl = URL.createObjectURL(blob); })
  .catch(() => { workerBlobUrl = null; });

function wait(ms){ return new Promise(r => setTimeout(r, ms)); }

async function startCamera(){
  permBox.classList.add('hidden');
  video.classList.remove('hidden');
  try{
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } },
      audio: false
    });
    video.srcObject = stream;
  }catch(err){
    video.classList.add('hidden');
    permBox.classList.remove('hidden');
  }
}

function grabGifFrame(){
  const vw = video.videoWidth;
  const vh = video.videoHeight;
  if(!vw || !vh) return null;
  const targetRatio = 3/4;
  let sw = vw, sh = vh;
  if (vw / vh > targetRatio){
    sw = vh * targetRatio;
  } else {
    sh = vw / targetRatio;
  }
  const sx = (vw - sw) / 2;
  const sy = (vh - sh) / 2;

  const GIF_W = 240, GIF_H = 320;
  captureCanvas.width = GIF_W;
  captureCanvas.height = GIF_H;
  const ctx = captureCanvas.getContext('2d');
  ctx.save();
  ctx.translate(GIF_W, 0);
  ctx.scale(-1, 1);
  ctx.drawImage(video, sx, sy, sw, sh, 0, 0, GIF_W, GIF_H);
  ctx.restore();
  return captureCanvas.toDataURL('image/jpeg', 0.75);
}

async function runCountdown(n){
  for(let i=n;i>0;i--){
    countOverlay.textContent = i;
    countOverlay.classList.add('show');
    await wait(700);
    countOverlay.classList.remove('show');
    await wait(150);
  }
}

async function flash(){
  flashOverlay.classList.remove('go');
  void flashOverlay.offsetWidth;
  flashOverlay.classList.add('go');
  await wait(180);
}

async function recordShot(){
  const frames = [];
  const FRAME_GAP = 130;
  const recorder = setInterval(() => {
    const f = grabGifFrame();
    if(f) frames.push(f);
  }, FRAME_GAP);

  await runCountdown(3);
  await flash();
  await wait(450);
  clearInterval(recorder);

  if(frames.length < 2) return frames;
  const tail = frames.slice(1, -1).reverse();
  return frames.concat(tail);
}

function encodeGif(frameDataUrls){
  return new Promise((resolve, reject) => {
    if(!window.GIF || !workerBlobUrl || frameDataUrls.length === 0){
      reject(new Error('gif engine unavailable'));
      return;
    }
    const gif = new GIF({
      workers: 2,
      quality: 14,
      width: 240,
      height: 320,
      workerScript: workerBlobUrl
    });
    let loaded = 0;
    frameDataUrls.forEach((src) => {
      const img = new Image();
      img.onload = () => {
        gif.addFrame(img, { delay: 110 });
        loaded++;
        if(loaded === frameDataUrls.length){
          gif.on('finished', (blob) => resolve(blob));
          gif.render();
        }
      };
      img.onerror = () => {
        loaded++;
        if(loaded === frameDataUrls.length){
          gif.on('finished', (blob) => resolve(blob));
          gif.render();
        }
      };
      img.src = src;
    });
  });
}

async function takeSequence(){
  if(busy) return;
  busy = true;
  goBtn.disabled = true;
  liveShots.forEach(s => { if(s && s.url) URL.revokeObjectURL(s.url); });
  liveShots = [];
  for(const d of shotDots){ d.classList.remove('filled'); }
  bulbs.classList.add('on');

  for(let shotIndex=0; shotIndex<2; shotIndex++){
    statusLine.textContent = `รูปที่ ${shotIndex+1} จาก 2 · เตรียมตัว`;
    const frames = await recordShot();
    shotDots[shotIndex].classList.add('filled');
    statusLine.textContent = `กำลังปรุง Live Photo ที่ ${shotIndex+1}...`;

    try{
      const blob = await encodeGif(frames);
      const url = URL.createObjectURL(blob);
      liveShots.push({ url, blob, frames });
    }catch(err){
      const fallback = frames[frames.length - 1] || frames[0];
      liveShots.push({ url: fallback, blob: null, isStill: true, frames: [fallback] });
    }
    statusLine.textContent = 'เนี้ยบ!';
    await wait(300);
  }

  bulbs.classList.remove('on');
  statusLine.textContent = 'กำลังจัดแถบฟิล์ม...';
  await wait(200);
  buildFilmStrip();
  busy = false;
  goBtn.disabled = false;
}

const FRAME_SLOTS = [
  { type:'rect', left: 15.0, top: 5.47,  width: 66.76, height: 31.82 },
  { type:'heart', left: 41.91, top: 32.41, width: 30.24, height: 15.56 }
];

function buildFilmStrip(){
  filmStrip.innerHTML = '';
  filmStrip.classList.remove('out');

  const slotEls = [];
  liveShots.forEach((shot, i) => {
    const pos = FRAME_SLOTS[i];
    const slot = document.createElement('div');
    slot.className = 'frameSlot';
    slot.style.left = pos.left + '%';
    slot.style.top = pos.top + '%';
    slot.style.width = pos.width + '%';
    slot.style.height = pos.height + '%';

    if(pos.type === 'heart'){
      slot.classList.add('heartSlot');
      slot.innerHTML = `
        <svg viewBox="0 0 100 96" preserveAspectRatio="xMidYMid meet" style="width:100%;height:100%;display:block;overflow:visible;">
          <defs>
            <clipPath id="heartClip${i}" clipPathUnits="userSpaceOnUse">
              <path d="M50 96 C15 72 0 50 0 30 C0 12 15 0 32 0 C42 0 48 8 50 14 C52 8 58 0 68 0 C85 0 100 12 100 30 C100 50 85 72 50 96 Z"/>
            </clipPath>
          </defs>
          <image href="${shot.url}" width="100" height="96" preserveAspectRatio="xMidYMid slice" clip-path="url(#heartClip${i})"/>
        </svg>`;
    } else {
      const img = document.createElement('img');
      img.src = shot.url;
      img.alt = shot.isStill ? `รูปที่ ${i+1}` : `ภาพเคลื่อนไหวที่ ${i+1}`;
      slot.appendChild(img);
    }

    filmStrip.appendChild(slot);
    slotEls.push(slot);
  });

  const art = document.createElement('img');
  art.className = 'frameArt';
  art.src = FRAME_ART_URI;
  art.alt = 'กรอบโฟโต้บูธ';
  filmStrip.appendChild(art);

  liveControls.classList.add('hidden');
  document.querySelector('.statusLine').classList.add('hidden');
  stripWrap.classList.remove('hidden');
  document.getElementById('booth').classList.add('gone');

  void filmStrip.offsetWidth;
  const BATCH_GAP = 1000;
  requestAnimationFrame(() => {
    filmStrip.classList.add('out');
    slotEls.forEach((slot, i) => {
      setTimeout(() => slot.classList.add('in'), 500 + i * BATCH_GAP);
    });
  });
  setTimeout(() => {
    stripActions.classList.add('ready');
  }, 500 + slotEls.length * BATCH_GAP + 900);
}

goBtn.addEventListener('click', takeSequence);
retryBtn.addEventListener('click', startCamera);

function loadImageAsync(src){
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });
}

function drawCoverOnCanvas(ctx, img, dx, dy, dw, dh){
  const ir = img.width / img.height;
  const br = dw / dh;
  let sx, sy, sw, sh;
  if(ir > br){
    sh = img.height; sw = img.height * br; sx = (img.width - sw) / 2; sy = 0;
  } else {
    sw = img.width; sh = img.width / br; sx = 0; sy = (img.height - sh) / 2;
  }
  ctx.drawImage(img, sx, sy, sw, sh, dx, dy, dw, dh);
}

const HEART_PATH_D = 'M50 96 C15 72 0 50 0 30 C0 12 15 0 32 0 C42 0 48 8 50 14 C52 8 58 0 68 0 C85 0 100 12 100 30 C100 50 85 72 50 96 Z';

async function composeFramedImage(){
  const CANVAS_W = 1080, CANVAS_H = 1920;
  const canvas = document.createElement('canvas');
  canvas.width = CANVAS_W;
  canvas.height = CANVAS_H;
  const ctx = canvas.getContext('2d');

  for(let i = 0; i < liveShots.length; i++){
    const pos = FRAME_SLOTS[i];
    const dx = pos.left / 100 * CANVAS_W;
    const dy = pos.top / 100 * CANVAS_H;
    const dw = pos.width / 100 * CANVAS_W;
    const dh = pos.height / 100 * CANVAS_H;
    const img = await loadImageAsync(liveShots[i].url);

    if(pos.type === 'heart'){
      ctx.save();
      ctx.translate(dx, dy);
      ctx.scale(dw / 100, dh / 96);
      ctx.clip(new Path2D(HEART_PATH_D));
      drawCoverOnCanvas(ctx, img, 0, 0, 100, 96);
      ctx.restore();
    } else {
      drawCoverOnCanvas(ctx, img, dx, dy, dw, dh);
    }
  }

  const frameImg = await loadImageAsync(FRAME_ART_URI);
  ctx.drawImage(frameImg, 0, 0, CANVAS_W, CANVAS_H);

  return canvas.toDataURL('image/jpeg', 0.92);
}

async function composeFramedGif(){
  if(!window.GIF || !workerBlobUrl) throw new Error('gif engine unavailable');
  if(liveShots.some(s => !s.frames || s.frames.length === 0)) throw new Error('no frames to animate');

  const GIF_W = 380;
  const GIF_H = Math.round(GIF_W * 1920 / 1080);
  const FRAME_DELAY = 110;

  const shotFrameImages = [];
  for(const shot of liveShots){
    const imgs = await Promise.all(shot.frames.map(loadImageAsync));
    shotFrameImages.push(imgs);
  }
  const frameArtImg = await loadImageAsync(FRAME_ART_URI);

  const maxLen = Math.max(...shotFrameImages.map(arr => arr.length));
  const STRIDE = Math.max(1, Math.ceil(maxLen / 22));

  const canvas = document.createElement('canvas');
  canvas.width = GIF_W;
  canvas.height = GIF_H;
  const ctx = canvas.getContext('2d');

  const gif = new GIF({ workers: 2, quality: 14, width: GIF_W, height: GIF_H, workerScript: workerBlobUrl });

  for(let f = 0; f < maxLen; f += STRIDE){
    ctx.clearRect(0, 0, GIF_W, GIF_H);
    for(let s = 0; s < shotFrameImages.length; s++){
      const imgs = shotFrameImages[s];
      const img = imgs[f % imgs.length];
      const pos = FRAME_SLOTS[s];
      const dx = pos.left / 100 * GIF_W;
      const dy = pos.top / 100 * GIF_H;
      const dw = pos.width / 100 * GIF_W;
      const dh = pos.height / 100 * GIF_H;

      if(pos.type === 'heart'){
        ctx.save();
        ctx.translate(dx, dy);
        ctx.scale(dw / 100, dh / 96);
        ctx.clip(new Path2D(HEART_PATH_D));
        drawCoverOnCanvas(ctx, img, 0, 0, 100, 96);
        ctx.restore();
      } else {
        drawCoverOnCanvas(ctx, img, dx, dy, dw, dh);
      }
    }
    ctx.drawImage(frameArtImg, 0, 0, GIF_W, GIF_H);
    gif.addFrame(ctx, { copy: true, delay: FRAME_DELAY });
  }

  return new Promise((resolve, reject) => {
    gif.on('finished', (blob) => resolve(blob));
    try{ gif.render(); }catch(e){ reject(e); }
  });
}

downloadAllBtn.addEventListener('click', async () => {
  const originalLabel = downloadAllBtn.textContent;
  downloadAllBtn.disabled = true;
  downloadAllBtn.textContent = 'กำลังปรุง Live Photo ติดกรอบ...';
  try{
    const blob = await composeFramedGif();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'photobooth-framed.gif';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }catch(err){
    try{
      downloadAllBtn.textContent = 'กำลังเตรียมไฟล์...';
      const dataUrl = await composeFramedImage();
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = 'photobooth-framed.jpg';
      document.body.appendChild(a);
      a.click();
      a.remove();
    }catch(err2){
      alert('ขอโทษค่ะ ดาวน์โหลดไม่สำเร็จ ลองใหม่อีกครั้ง');
    }
  }
  downloadAllBtn.disabled = false;
  downloadAllBtn.textContent = originalLabel;
});

retakeBtn.addEventListener('click', () => {
  stripWrap.classList.add('hidden');
  document.getElementById('booth').classList.remove('gone');
  stripActions.classList.remove('ready');
  liveControls.classList.remove('hidden');
  document.querySelector('.statusLine').classList.remove('hidden');
  statusLine.textContent = 'กดปุ่มเพื่อเริ่มถ่าย 2 รูปติดกัน';
  for(const d of shotDots){ d.classList.remove('filled'); }
});

startCamera();
</script>
</body>
